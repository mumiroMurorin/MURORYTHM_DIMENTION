# Auto detect text files and perform LF normalization
* text=auto

# Source code: always CRLF in the working tree (LF inside the repository),
# regardless of each user's core.autocrlf setting. See also .editorconfig.
*.cs      text eol=crlf
*.shader  text eol=crlf
*.hlsl    text eol=crlf
*.cginc   text eol=crlf
*.compute text eol=crlf
