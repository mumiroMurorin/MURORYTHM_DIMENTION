    m_Localized: "\u65E9\u901F\u3067\u3059\u304C\u3001\u3053\u306E\u30B2\u30FC\u30E0\u3092\u69CB\u6210\u3059\u308B\n<#ff3333>\u30CE\u30FC\u30C4</color>\u3068\u547C\u3070\u308C\u308B\u3082\u306E\u3092\u7D39\u4ECB\u3057\u307E\u3059\uFF01\r\n\u97F3\u697D\u30B2\u30FC\u30E0\u306E\u30D7\u30EC\u30A4\u306B\u3001\u3068\u3063\u3066\u3082\u3001\u5927\u4E8B\u306A\u3082\u306E\u3067\u3059\uFF01"
