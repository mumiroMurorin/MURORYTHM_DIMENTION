      m_Items: []
  - m_Id: 241414033408
    m_Localized: "\u3053\u306E\u30CE\u30FC\u30C4\u304C\u6765\u305F\u3089\u3001<#ffff00>\u9EC4\u8272\u3044\u7DDA</color>\u306B\u5408\u308F\u305B\u3066<#ff3333>\u30BF\u30C3\u30C1</color>\u3060\uFF01\n\u30EA\u30BA\u30E0\u306B\u4E57\u3063\u3066\u30BF\u30C3\u30C1\u3059\u308B\u3068\u3044\u3044\uFF01"
